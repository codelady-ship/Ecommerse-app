# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB connection string, e.g. a free MongoDB Atlas M0 cluster:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hueline?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hueline

# 32+ random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated list of origins allowed to call the API (no trailing slash).
CORS_ORIGIN=http://localhost:5173,https://codelady-ship.github.io

# Admin user created/updated by `npm run seed` (password: 10+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# The seed also creates a public READ-ONLY demo admin (demo@hueline.az / demo1234) for the portfolio.
# Every write it tries gets a 403. DEMO_ADMIN=off skips it (and removes it if it exists).
# DEMO_ADMIN=off

# Image uploads: local folder by default. Set CLOUDINARY_URL to store them on Cloudinary instead.
UPLOAD_DIR=uploads
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

RATE_LIMIT_PER_MINUTE=120
