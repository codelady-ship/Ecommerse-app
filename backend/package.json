{
  "name": "hueline-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the HUELINE demo shop: catalogue, search, bag and saved lists, demo checkout, newsletter, delivery estimates and JWT admin.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.10",
    "multer": "^2.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.1.4"
  }
}
